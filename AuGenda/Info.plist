<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export compliance: CryptoKit AES-GCM/PBKDF2 uses standard Apple OS encryption exempt from US EAR classification -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AuGenda checks the weather for your outdoor routine blocks so it can suggest what to grab — a coat, sunscreen, umbrella. Location stays on your device and is only sent to Apple's WeatherKit. AuGenda never shares your location with anyone else.</string>

	<!-- Brain dump voice capture — on-device only, audio never leaves the device -->
	<key>NSMicrophoneUsageDescription</key>
	<string>AuGenda uses the microphone to let you dictate brain dumps. Audio is processed on your device using Apple's on-device speech recognition — nothing is sent to any server.</string>

	<key>NSSpeechRecognitionUsageDescription</key>
	<string>AuGenda transcribes voice brain dumps using on-device speech recognition. No audio or text leaves your device.</string>

	<key>NSLocalNetworkUsageDescription</key>
	<string>AuGenda connects to an Ollama server you configure on your local network after you enable self-hosted AI. Task content is sent only when you ask AuGenda to enrich it.</string>

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Launch screen — solid dark color matching the dashboard's actual
	     appBackground in dark mode (slate900 / #0F172A). Without this iOS
	     defaults to a white launch screen and users see a brief light flash
	     before SwiftUI's preferredColorScheme(.dark) takes over. The colour
	     asset has no light/dark variants so launch stays dark on every
	     system appearance. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!-- Public Google OAuth configuration is expanded from build settings
	     into the built product. Placeholder values keep sign-in disabled;
	     API-key Gemini remains available. validate-oauth.sh checks the
	     expanded product for partial or inconsistent configuration. -->
	<key>AuGendaGoogleClientID</key>
	<string>$(AUGENDA_GOOGLE_CLIENT_ID)</string>
	<key>AuGendaGoogleRedirectScheme</key>
	<string>$(AUGENDA_GOOGLE_REDIRECT_SCHEME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>google-oauth-gemini</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(AUGENDA_GOOGLE_REDIRECT_SCHEME)</string>
			</array>
		</dict>
	</array>

	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
</dict>
</plist>
